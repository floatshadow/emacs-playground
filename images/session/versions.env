# Pinned versions for the session image (emacs.md §2). Single source of truth:
# the Dockerfile sources this file in the stages that need it (through small
# "pins" extracts so that a change here only rebuilds the affected stage), and
# it is copied to /opt/playground/versions.env where sessiond reports it in
# GET /status. Keys are KEY=VALUE without quotes so both sh and Go can read
# them. Checksums are sha256 of the exact download.

# --- Emacs (emacs.md §1) -----------------------------------------------------
# 31.1 is built (verified with the GNU keyring: signed by Sean Whitton,
# subkey 9B91 7007 AE03 0E36 E4FC 248B 695B 7AE4 BF06 6240). The fallback is
# documented but not used.
EMACS_VERSION=31.1
EMACS_SHA256=1da5790d9580c81932b5bf700633114468da7b3412d69faa767daebf974f4586
EMACS_FALLBACK_VERSION=30.2

# --- Terminal, display, fonts (emacs.md §2, §5, §6) --------------------------
# Debian trixie packages; the build checks the installed versions match.
TMUX_VERSION=3.5a
# Iosevka Nerd Font: Regular, Bold, Italic, BoldItalic from the release tarball.
NERD_FONTS_VERSION=3.5.1
NERD_FONTS_IOSEVKA_SHA256=3b94ea1dc3955756762f977b7677bca671947dd56bc755a6f8465a8e83b5f257

# --- Rust (emacs.md §2) -------------------------------------------------------
RUSTUP_VERSION=1.29.2
RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
RUST_TOOLCHAIN=1.99.1
RUST_COMPONENTS=rust-analyzer,clippy,rustfmt,rust-src

# --- Python (emacs.md §2) -----------------------------------------------------
UV_VERSION=0.13.5
UV_SHA256=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
BASEDPYRIGHT_VERSION=1.40.2
RUFF_VERSION=0.17.2

