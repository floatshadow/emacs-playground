# Pinned versions for the session image (emacs.md §2). The Dockerfile reads
# these; sessiond reports them in GET /status (copied to
# /opt/playground/versions.env). TODO(emacs): fill in every pin and record the
# actual Emacs version built (31.1, or 30.2 if the fallback was used).
EMACS_VERSION=31.1
EMACS_FALLBACK_VERSION=30.2
TMUX_VERSION=3.5a
