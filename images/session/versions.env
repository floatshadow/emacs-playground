# --- TeX (emacs.md §2) -------------------------------------------------------
# TeX Live 2025 from its frozen final repository (tlnet-final): the
# newest year that no longer changes, so the build is reproducible; the
# live 2026 repository changes daily.  tlmgr checks every package
# against the tlpdb, whose sha512 is pinned here.
TEXLIVE_YEAR=2025
TEXLIVE_REPOSITORY=https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/2025/tlnet-final
TEXLIVE_INSTALLER_SHA256=311df9f1477fd90c520159d1feddc2d6270f010d8349d1f6bdb9461a93b48a5c
TEXLIVE_TLPDB_SHA512=2fb7adc54cff58fa55c5b7c1bd3034e1efd849d0b73535c8dcdf0d8a36f66998b7a578ae036ef24354641be5f3738b0ad1323b7318581d88a0e271d1ac12cb2b
TEXLAB_VERSION=5.26.0
TEXLAB_SHA256=8697bd5e479d4584b14b7eed5c320c80ec4e1d91ebefbb6801e6bf38e9971300

