PIP_VERSION=26.2.2

# --- OCaml (emacs.md §2) -----------------------------------------------------
# opam's static release binary; the switch's packages are resolved from
# opam-repository at this commit (the archive's sha256 below) and the
# list in prefetch/opam.txt.
OPAM_VERSION=2.6.1
OPAM_SHA256=b533d393a6967150d6ef41cb3d71e147e93ecbabeb59e921aa412c0ae79ebe3d
OPAM_REPOSITORY_COMMIT=93c0c4ad02a9a92cc3333f11a4b61d16c52753f2
OPAM_REPOSITORY_SHA256=641c38b95c5c40a852fc42b6203a4b10b525e294087523683bd8d6da7665c395
# 5.4, not 5.5: ocamlfind (utop needs it) has no release for 5.5 yet, only
# a preview.
OCAML_VERSION=5.4.1

# --- Typst (emacs.md §2) -----------------------------------------------------
TYPST_VERSION=0.15.1
TYPST_SHA256=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c
