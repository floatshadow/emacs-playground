{
  "name": "snapshot-two-windows-with-point",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    },
    {
      "file": "sub/b.txt",
      "contents": "This is b.\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-n"
    },
    {
      "press": "C-x 2"
    },
    {
      "press": "C-x o"
    },
    {
      "press": "C-x C-f"
    },
    {
      "type": "sub/b.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-x o"
    },
    {
      "call": "snapshot",
      "args": {},
      "exact": [
        "files[].path",
        "files[].point",
        "files[].visible",
        "layout",
        "selected",
        "tab",
        "tabs",
        "tabIndex"
      ]
    }
  ],
  "calls": [
    {
      "op": "snapshot",
      "ok": true,
      "reply": {
        "files": [
          {
            "path": "a.txt",
            "point": 10,
            "visible": true
          },
          {
            "path": "sub/b.txt",
            "point": 1,
            "visible": true
          }
        ],
        "layout": "(vsplit a.txt sub/b.txt)",
        "windowState": "(((min-height . 8) (min-width . 10) (min-height-ignore . 4) (min-width-ignore . 2) (min-height-safe . 2) (min-width-safe . 2) (min-pixel-height . 8) (min-pixel-width . 10) (min-pixel-height-ignore . 4) (min-pixel-width-ignore . 2) (min-pixel-height-safe . 2) (min-pixel-width-safe . 2)) vc (pixel-width . 80) (pixel-height . 23) (total-width . 80) (total-height . 23) (normal-height . 1.0) (normal-width . 1.0) (combination-limit) (leaf (pixel-width . 80) (pixel-height . 12) (total-width . 80) (total-height . 12) (normal-height . 0.5) (normal-width . 1.0) (buffer \"a.txt\" (selected . t) (hscroll . 0) (fringes 0 0 nil nil) (margins nil) (scroll-bars nil 0 t nil 0 t nil) (vscroll . 0) (dedicated) (point . 10) (start . 1) (file . \"$WS/a.txt\")) (prev-buffers (\"*scratch*\" 1 1))) (leaf (last . t) (pixel-width . 80) (pixel-height . 11) (total-width . 80) (total-height . 11) (normal-height . 0.5) (normal-width . 1.0) (buffer \"b.txt\" (selected) (hscroll . 0) (fringes 0 0 nil nil) (margins nil) (scroll-bars nil 0 t nil 0 t nil) (vscroll . 0) (dedicated) (point . 1) (start . 1) (file . \"$WS/sub/b.txt\")) (prev-buffers (\"a.txt\" 1 10 \"$WS/a.txt\"))))",
        "selected": "a.txt",
        "tab": "a.txt",
        "tabs": [
          ""
        ],
        "tabIndex": 1,
        "specialBuffers": "nil"
      },
      "exact": [
        "files[].path",
        "files[].point",
        "files[].visible",
        "layout",
        "selected",
        "tab",
        "tabs",
        "tabIndex"
      ]
    }
