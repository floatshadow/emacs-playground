{
  "name": "spec-with-help",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-h f"
    },
    {
      "type": "find-file"
    },
    {
      "press": "RET"
    },
    {
      "call": "capture-editor",
      "args": {
        "workspace": "$WS",
        "vars": [],
        "maxText": 0,
        "maxUndo": 0,
        "maxTotal": 0,
        "maxGlobals": 0
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.files[].visible",
        "spec.layout",
        "spec.selected",
        "spec.tab",
        "spec.tabs",
        "spec.tabIndex"
      ]
    }
  ],
