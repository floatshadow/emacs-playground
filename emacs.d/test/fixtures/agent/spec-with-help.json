          "selected": "a.txt",
          "tab": "a.txt",
          "tabs": [
            ""
          ],
          "tabIndex": 1,
          "specialBuffers": "((\"*Help*\" (describe-function--helper find-file nil)))"
        },
        "buffers": {},
        "globals": null
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.files[].visible",
        "spec.layout",
        "spec.selected",
        "spec.tab",
        "spec.tabs",
        "spec.tabIndex"
      ]
    }
