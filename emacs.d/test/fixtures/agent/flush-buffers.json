{
  "name": "flush-buffers",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "type": "done "
    },
    {
      "call": "flush-buffers",
      "exact": [
        "saved"
      ]
    },
    {
      "call": "check",
      "args": {
        "forms": [
          "(let ((pg-b (or (get-buffer \"a.txt\") (seq-find (lambda (b) (let ((n (buffer-name b))) (and (string-prefix-p (concat \"a.txt\" \"<\") n) (string-suffix-p \">\" n)))) (buffer-list))))) (and pg-b (with-current-buffer pg-b (and (save-excursion (save-restriction (widen) (goto-char (point-min)) (search-forward \"line two\" nil t))) (not (buffer-modified-p)) t))))"
        ]
      },
      "exact": [
        "results"
      ]
    },
    {
      "call": "flush-buffers",
      "exact": [
        "saved"
      ]
    }
  ],
  "calls": [
    {
      "op": "flush-buffers",
      "ok": true,
      "reply": {
        "saved": 1
      },
      "exact": [
        "saved"
      ]
    },
    {
      "op": "check",
      "ok": true,
      "reply": {
        "results": [
          true
        ]
      },
      "exact": [
        "results"
      ]
    },
    {
      "op": "flush-buffers",
      "ok": true,
      "reply": {
        "saved": 0
      },
      "exact": [
        "saved"
      ]
    }
  ],
