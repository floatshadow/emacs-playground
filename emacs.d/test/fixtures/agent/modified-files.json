{
  "name": "modified-files",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    },
    {
      "file": "sub/b.txt",
      "contents": "This is b.\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "sub/b.txt"
    },
    {
      "press": "RET"
    },
    {
      "type": "x"
    },
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "call": "modified-files",
      "args": {
        "workspace": "$WS"
      },
      "exact": [
        "paths"
      ]
    }
  ],
  "calls": [
    {
      "op": "modified-files",
      "ok": true,
      "reply": {
        "paths": [
          "sub/b.txt"
        ]
      },
      "exact": [
        "paths"
      ]
    }
