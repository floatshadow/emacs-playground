{
  "name": "modified-files",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    },
    {
      "file": "sub/b.txt",
      "contents": "This is b.\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "sub/b.txt"
    },
    {
      "press": "RET"
    },
    {
      "type": "x"
    },
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "call": "modified-files",
      "args": {
        "workspace": "$WS"
      },
      "exact": [
        "paths"
      ]
    }
  ],
  "calls": [
    {
      "op": "modified-files",
      "ok": true,
      "reply": {
        "paths": [
          "sub/b.txt"
        ]
      },
      "exact": [
        "paths"
      ]
    }
  ],
  "events": [
    {
      "t": "key",
      "keys": "C-x C-f",
      "cmd": "find-file",
      "buf": "*scratch*",
      "mode": "lisp-interaction-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": true,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    },
    {
      "t": "key",
      "keys": "s",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "u",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "b",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "/",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "b",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": ".",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "x",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "RET",
      "cmd": "minibuffer-complete-and-exit",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": false,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    },
    {
      "t": "key",
      "keys": "x",
      "cmd": "self-insert-command",
      "buf": "b.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "C-x C-f",
      "cmd": "find-file",
      "buf": "b.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": true,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    },
    {
      "t": "key",
      "keys": "a",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": ".",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "x",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "RET",
      "cmd": "minibuffer-complete-and-exit",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": false,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    }
  ],
  "state": {
    "t": "state",
    "buf": "a.txt",
    "file": "$WS/sub/a.txt",
    "mode": "text-mode",
    "modeName": "",
    "minors": [],
    "modified": false,
    "readonly": false,
    "narrowed": false,
    "overwrite": false,
    "line": 1,
    "col": 0,
    "point": 1,
    "markActive": false,
    "windows": [
      {
        "id": 15,
        "buf": "a.txt",
        "mode": "text-mode",
        "selected": true,
        "dedicated": false,
        "side": null
      }
    ],
    "layout": 15,
    "frame": "terminal",
    "frames": 1,
    "tabs": {
      "count": 1,
      "current": "a.txt"
