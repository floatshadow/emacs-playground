    "minibuffer": null,
    "isearch": false,
    "recursive": 0,
    "macro": false,
    "prefixArg": null,
    "waiting": null,
    "readOnlyReason": null,
    "diagAtPoint": null
  },
  "eventsExact": {
    "key": [
      "keys",
      "cmd",
      "buf",
      "mode"
    ],
    "minibuffer": [
      "open",
      "prompt",
      "depth",
      "kind"
    ],
    "state": [
      "buf",
      "mode",
      "modified",
