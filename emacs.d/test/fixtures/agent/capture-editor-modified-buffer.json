            true,
            "edited line one\nline tw\n",
            "(nil (\"o\" . 24) nil (1 . 8) (t 27367 7226 282648 762000))"
          ]
        },
        "globals": "((kill-ring \"o\"))"
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.layout",
        "spec.selected"
      ]
