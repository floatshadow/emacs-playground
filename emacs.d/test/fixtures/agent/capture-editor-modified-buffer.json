{
  "name": "capture-editor-modified-buffer",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    },
    {
      "file": "b.txt",
      "contents": "This is b.\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "type": "edited "
    },
    {
      "press": "C-n"
    },
    {
      "press": "C-k"
    },
    {
      "press": "C-x C-f"
    },
    {
      "type": "b.txt"
    },
    {
      "press": "RET"
    },
    {
      "call": "capture-editor",
      "args": {
        "workspace": "$WS",
        "vars": [
          "kill-ring"
        ],
        "maxText": 262144,
        "maxUndo": 131072,
        "maxTotal": 524288,
        "maxGlobals": 262144
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.layout",
        "spec.selected"
      ]
    }
  ],
