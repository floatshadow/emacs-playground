{
  "name": "restore-editor-roundtrip",
  "setup": [
    {
      "file": "a.txt",
      "contents": "line one\nline two\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "a.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-n"
    },
    {
      "press": "C-k"
    },
    {
      "press": "C-p"
    },
    {
      "type": "edited "
    },
    {
      "call": "capture-editor",
      "args": {
        "workspace": "$WS",
        "vars": [
          "kill-ring"
        ],
        "maxText": 262144,
        "maxUndo": 131072,
        "maxTotal": 524288,
        "maxGlobals": 262144
      },
      "as": "s1",
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.layout",
        "spec.selected"
      ]
    },
    {
      "press": "C-k"
    },
    {
      "press": "C-x C-s"
    },
    {
      "press": "M->"
    },
    {
      "call": "restore-editor",
      "args": {
        "workspace": "$WS",
        "spec": "$s1.spec",
        "buffers": "$s1.buffers",
        "globals": "$s1.globals"
      },
      "exact": [
        "reverted",
        "killed",
        "buffers",
        "globals",
        "degraded"
      ]
    },
    {
      "call": "capture-editor",
      "args": {
        "workspace": "$WS",
        "vars": [],
        "maxText": 0,
        "maxUndo": 0,
        "maxTotal": 0,
        "maxGlobals": 0
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.files[].visible",
        "spec.layout",
        "spec.selected",
        "spec.tab",
        "spec.tabs",
        "spec.tabIndex"
      ]
    },
    {
      "call": "check",
      "args": {
        "forms": [
          "(let ((pg-b (or (get-buffer \"a.txt\") (seq-find (lambda (b) (let ((n (buffer-name b))) (and (string-prefix-p (concat \"a.txt\" \"<\") n) (string-suffix-p \">\" n)))) (buffer-list))))) (and pg-b (with-current-buffer pg-b (and (save-excursion (save-restriction (widen) (goto-char (point-min)) (search-forward \"edited line one\" nil t))) (buffer-modified-p) t))))"
        ]
      },
      "exact": [
        "results"
      ]
    },
    {
      "press": "C-y"
    },
    {
      "press": "C-/"
    },
    {
      "press": "C-/"
    }
  ],
