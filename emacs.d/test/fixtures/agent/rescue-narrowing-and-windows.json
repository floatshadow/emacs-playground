{
  "name": "rescue-narrowing-and-windows",
  "setup": [
    {
      "file": "n.txt",
      "contents": "one\ntwo\nthree\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "n.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-SPC"
    },
    {
      "press": "C-n"
    },
    {
      "press": "C-x n n"
    },
    {
      "press": "<insert>"
    },
    {
      "press": "C-x 2"
    },
    {
      "call": "rescue",
      "exact": [
        "did"
      ]
    },
    {
      "call": "capture-editor",
      "args": {
        "workspace": "$WS",
        "vars": [],
        "maxText": 0,
        "maxUndo": 0,
        "maxTotal": 0,
        "maxGlobals": 0
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.files[].visible",
        "spec.layout",
        "spec.selected",
        "spec.tab",
        "spec.tabs",
        "spec.tabIndex"
      ]
    }
  ],
  "calls": [
    {
      "op": "rescue",
      "ok": true,
      "reply": {
        "did": [
          "turned off overwrite mode",
          "widened n.txt",
          "closed 1 other window"
        ]
      },
      "exact": [
        "did"
      ]
    },
    {
      "op": "capture-editor",
      "ok": true,
      "reply": {
        "spec": {
          "files": [
            {
              "path": "n.txt",
              "point": 5,
              "visible": true
            }
          ],
          "layout": "n.txt",
          "windowState": "(((min-height . 4) (min-width . 10) (min-height-ignore . 2) (min-width-ignore . 2) (min-height-safe . 1) (min-width-safe . 2) (min-pixel-height . 4) (min-pixel-width . 10) (min-pixel-height-ignore . 2) (min-pixel-width-ignore . 2) (min-pixel-height-safe . 1) (min-pixel-width-safe . 2)) leaf (pixel-width . 80) (pixel-height . 22) (total-width . 80) (total-height . 22) (normal-height . 1.0) (normal-width . 1.0) (buffer \"n.txt\" (selected . t) (hscroll . 0) (fringes 0 0 nil nil) (margins nil) (scroll-bars nil 0 t nil 0 t nil) (vscroll . 0) (dedicated) (point . 5) (start . 1) (file . \"$WS/n.txt\")) (prev-buffers (\"*scratch*\" 1 1)))",
          "selected": "n.txt",
          "tab": "n.txt",
          "tabs": [
            ""
          ],
          "tabIndex": 1,
          "specialBuffers": "nil"
        },
        "buffers": {},
        "globals": null
      },
      "exact": [
        "spec.files[].path",
        "spec.files[].point",
        "spec.files[].visible",
        "spec.layout",
        "spec.selected",
        "spec.tab",
        "spec.tabs",
        "spec.tabIndex"
      ]
    }
  ],
  "events": [
    {
      "t": "key",
      "keys": "C-x C-f",
      "cmd": "find-file",
      "buf": "*scratch*",
      "mode": "lisp-interaction-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": true,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    },
    {
      "t": "key",
      "keys": "n",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": ".",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "x",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "t",
      "cmd": "self-insert-command",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "RET",
      "cmd": "minibuffer-complete-and-exit",
      "buf": " *Minibuf-1*",
      "mode": "minibuffer-mode",
      "frame": "terminal"
    },
    {
      "t": "minibuffer",
      "open": false,
      "prompt": "Find file: ",
      "depth": 1,
      "kind": "prompt"
    },
    {
      "t": "key",
      "keys": "C-SPC",
      "cmd": "set-mark-command",
      "buf": "n.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "C-n",
      "cmd": "next-line",
      "buf": "n.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "C-x n n",
      "cmd": "narrow-to-region",
      "buf": "n.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "<insert>",
      "cmd": "overwrite-mode",
      "buf": "n.txt",
      "mode": "text-mode",
      "frame": "terminal"
    },
    {
      "t": "key",
      "keys": "C-x 2",
      "cmd": "split-window-below",
      "buf": "n.txt",
      "mode": "text-mode",
      "frame": "terminal"
    }
  ],
  "state": {
    "t": "state",
    "buf": "n.txt",
    "file": "$WS/n.txt",
    "mode": "text-mode",
    "modeName": "",
    "minors": [],
    "modified": false,
    "readonly": false,
    "narrowed": false,
    "overwrite": false,
    "line": 2,
    "col": 0,
    "point": 5,
    "markActive": false,
    "windows": [
      {
        "id": 13,
        "buf": "n.txt",
        "mode": "text-mode",
        "selected": true,
        "dedicated": false,
        "side": null
      }
    ],
    "layout": 13,
    "frame": "terminal",
    "frames": 1,
    "tabs": {
      "count": 1,
      "current": "n.txt"
    },
    "minibuffer": null,
    "isearch": false,
    "recursive": 0,
    "macro": false,
    "prefixArg": null,
    "waiting": null,
    "readOnlyReason": null,
    "diagAtPoint": null
  },
  "eventsExact": {
    "key": [
      "keys",
      "cmd",
      "buf",
      "mode"
    ],
    "minibuffer": [
      "open",
      "prompt",
      "depth",
      "kind"
    ],
    "state": [
      "buf",
      "mode",
      "modified",
      "narrowed",
      "overwrite",
      "readonly",
      "line",
      "col",
      "point",
      "markActive",
      "frame",
      "isearch",
      "recursive"
    ]
  }
}
