{
  "name": "rescue-narrowing-and-windows",
  "setup": [
    {
      "file": "n.txt",
      "contents": "one\ntwo\nthree\n"
    }
  ],
  "steps": [
    {
      "press": "C-x C-f"
    },
    {
      "type": "n.txt"
    },
    {
      "press": "RET"
    },
    {
      "press": "C-SPC"
    },
    {
      "press": "C-n"
    },
    {
      "press": "C-x n n"
    },
    {
      "press": "<insert>"
    },
    {
      "press": "C-x 2"
    },
    {
      "call": "rescue",
      "exact": [
        "did"
      ]
    },
    {
      "call": "snapshot",
      "args": {},
      "exact": [
        "files[].path",
        "files[].point",
        "files[].visible",
        "layout",
        "selected",
        "tab",
        "tabs",
        "tabIndex"
      ]
    }
  ],
  "calls": [
    {
      "op": "rescue",
      "ok": true,
      "reply": {
        "did": [
          "turned off overwrite mode",
          "widened n.txt",
          "closed 1 other window"
        ]
      },
      "exact": [
        "did"
      ]
    },
