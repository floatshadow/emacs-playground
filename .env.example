# Written by `make local` or `make server` (deployment.md §2). Only Compose
# selection, the image tag and the domain live here; everything else is in
# deploy/config.json.
COMPOSE_FILE=compose.yaml:compose.local.yaml
TAG=latest
DOMAIN=
# Image registry prefix; forks publish under their own owner.
IMAGE_BASE=ghcr.io/floatshadow/emacs-playground
